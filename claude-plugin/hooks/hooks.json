{
  "description": "Inject new standards once per session, record the transcript for compact-check, and gate AskUserQuestion by role.",
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/standards-inject.sh\" SessionStart", "timeout": 10 },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_record.py\"", "timeout": 5 }
      ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/standards-inject.sh\" UserPromptSubmit", "timeout": 10 },
        { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_record.py\"", "timeout": 5 }
      ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/standards-inject.sh\" PostToolUse", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ask_gate.py\"", "timeout": 12 } ] }
    ]
  }
}
